{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names site,docs \"vite\" \"vitepress dev docs --host 127.0.0.1 --port 5174\"",
    "docs:dev": "vitepress dev docs",
    "build": "npm run build:site && npm run build:docs",
    "build:site": "vite build",
    "build:docs": "vitepress build docs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build && python3 tools/stamp-cache.py && python3 tools/stamp-sitemap.py",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "gh-pages": "^6.3.0",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.11.0",
    "bulma": "^0.9.4",
    "jszip": "^3.10.1",
    "jsdom": "^30.0.1",
    "three": "^0.185.1",
    "vue": "^3.5.42"
  }
}

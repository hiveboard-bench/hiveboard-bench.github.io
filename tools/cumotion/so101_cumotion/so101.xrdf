format: xrdf
format_version: 2.0

modifiers:
  - set_base_frame: "base_link"

default_joint_positions:
  shoulder_pan: 0.0
  shoulder_lift: -0.6
  elbow_flex: 0.9
  wrist_flex: 0.6
  wrist_roll: 0.0
  gripper: 0.0

cspace:
  joint_names:
    - "shoulder_pan"
    - "shoulder_lift"
    - "elbow_flex"
    - "wrist_flex"
    - "wrist_roll"
  acceleration_limits: [15.0, 15.0, 15.0, 15.0, 15.0]
  jerk_limits: [1000.0, 1000.0, 1000.0, 1000.0, 1000.0]

tool_frames:
  - "tcp"
